{
  "name": "foyer",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=20.11" },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:validate": "pnpm --filter @foyer/db exec prisma validate",
    "db:migrate": "pnpm --filter @foyer/db exec prisma migrate dev",
    "db:generate": "pnpm --filter @foyer/db exec prisma generate",
    "db:studio": "pnpm --filter @foyer/db exec prisma studio",
    "eval": "pnpm --filter @foyer/eval run eval",
    "format": "prettier --write \"**/*.{ts,tsx,md,json,css}\""
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "eslint": "9.17.0",
    "prettier": "3.4.2",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.19.0"
  }
}
