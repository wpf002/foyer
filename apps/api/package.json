{
  "name": "@foyer/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "tsx --env-file-if-exists=../../.env src/server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "tsx --test test/*.test.ts",
    "set-password": "tsx --env-file-if-exists=../../.env scripts/set-password.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.5",
    "@fastify/cors": "10.0.1",
    "@fastify/multipart": "9.4.0",
    "@fastify/rate-limit": "11.2.1",
    "@foyer/ai": "workspace:*",
    "@foyer/artifacts": "workspace:*",
    "@foyer/cost": "workspace:*",
    "@foyer/db": "workspace:*",
    "@foyer/rubric": "workspace:*",
    "@node-rs/argon2": "2.2.2",
    "fastify": "5.2.0",
    "fastify-plugin": "5.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
