{
  "name": "@foyer/eval",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "eval": "tsx --env-file-if-exists=../.env src/run.ts",
    "blind": "tsx src/blind.ts",
    "calibrate": "tsx src/calibrate.ts",
    "test": "tsx --test test/*.test.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test"
  },
  "dependencies": {
    "@foyer/ai": "workspace:*",
    "@foyer/artifacts": "workspace:*",
    "@foyer/cost": "workspace:*",
    "@foyer/rubric": "workspace:*"
  },
  "devDependencies": {
    "sharp": "0.33.5",
    "tsx": "4.19.2"
  }
}
