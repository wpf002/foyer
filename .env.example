# ---------------------------------------------------------------------------
# Foyer — environment
# Copy to .env and fill. Never commit .env.
# ---------------------------------------------------------------------------

NODE_ENV=development

# Postgres. Local docker or a hosted Postgres URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/foyer?schema=public"

# ---------------------------------------------------------------------------
# Claude. Read only by packages/ai, which runs server-side (apps/api, eval).
# apps/web never reads it, and it never reaches a browser.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=""

# Model tiering. Cheap model parses intake and classifies; the reasoning
# tier only ever runs the design critique and the roadmap.
FOYER_MODEL_CHEAP="claude-haiku-5-5"
FOYER_MODEL_REASONING="claude-opus-5-5"
FOYER_MODEL_VISION="claude-opus-5-5"
FOYER_MODEL_JUDGE="claude-sonnet-5-5"

# Prompt caching. The rubric and brief are large and stable; cache them.
FOYER_PROMPT_CACHE=1

# Spend caps, enforced in packages/ai before any call leaves the process.
FOYER_SPEND_CAP_USER_USD=5
FOYER_SPEND_CAP_GLOBAL_USD=250

# Cost baseline adapter (packages/cost). Leave blank to use the bundled
# static baseline sample.
COST_BASELINE_PROVIDER="static"
COST_BASELINE_API_KEY=""

# apps/api
API_PORT=4000
API_HOST="0.0.0.0"
NEXT_PUBLIC_API_URL="http://localhost:4000"
